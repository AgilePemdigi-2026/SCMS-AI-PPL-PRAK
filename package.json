{
  "name": "scms-ai-css",
  "private": true,
  "description": "Builds app/static/css/tailwind.css from the templates and copies vendor JS (Chart.js) to app/static/js (no CDN at runtime).",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i app/static/css/input.css -o app/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i app/static/css/input.css -o app/static/css/tailwind.css --watch",
    "build:vendor": "node -e \"require('fs').copyFileSync('node_modules/chart.js/dist/chart.umd.js', 'app/static/js/chart.umd.js')\""
  },
  "devDependencies": {
    "chart.js": "4.4.1",
    "tailwindcss": "3.4.17"
  }
}
