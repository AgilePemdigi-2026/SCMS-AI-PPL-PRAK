@startuml
title Sequence Diagram - UC-E: Mencatat Hasil Inspeksi Lapangan (Sprint 3: hitung ulang Risk Score & rekomendasi tutup)
actor "Penilik Jalan" as PJ
actor "Admin" as Adm
boundary "HalamanInspeksi\n(UI)" as UI
boundary "PanelWorkOrder\n(UI)" as WOUI
control "KontrolInspeksi" as Ctrl
control "KontrolPenanganan" as Pen
participant "risk_scoring" as RS
participant "alur_status" as AS
entity "WorkOrder" as WO
entity "Laporan" as Lap
entity "Inspeksi" as Insp
entity "Notifikasi" as Notif

PJ -> UI : Buka tugas yang ditugaskan kepadanya
activate UI
UI -> Ctrl : detail(id_work_order, id_penilik)
activate Ctrl
Ctrl --> UI : form (kategori terisi, 4 tingkat kerusakan, rekomendasi + "Rekomendasikan Tutup", alasan)
deactivate Ctrl

PJ -> UI : konfirmasi kategori, tingkat kerusakan, rekomendasi / alasan tutup, foto & submit
UI -> Ctrl : simpan_inspeksi(..., tingkat_kerusakan, kategori_terkonfirmasi, alasan_rekomendasi)
activate Ctrl
alt Form tidak lengkap (tanpa tingkat kecuali "Tidak ditemukan kerusakan", tanpa alasan tutup, dst.)
    Ctrl --> UI : pesan peringatan, tidak ada yang disimpan
else Valid
    opt tingkat kerusakan diisi
        Ctrl -> RS : terapkan_ke_work_order(severity lapangan menggantikan severity AI)
        RS --> Ctrl : risk_score & prioritas baru
    end
    Ctrl -> Insp : create(kategori_terkonfirmasi, tingkat_kerusakan, severity_lapangan, rekomendasi_tutup, alasan_rekomendasi)
    Ctrl -> AS : ubah_status("Terinspeksi", "...; Risk Score diperbarui X -> Y berdasarkan inspeksi")
    AS -> WO : compare-and-set + riwayat
    AS -> Notif : notifikasi per warga pelapor unik
    Ctrl --> UI : "Hasil inspeksi berhasil disimpan"
end
deactivate Ctrl
UI --> PJ : tampilkan hasil
deactivate UI

opt Temuan baru di sekitar lokasi (CO-2)
    PJ -> UI : "Catat Temuan Baru": foto, kategori, deskripsi, titik peta
    activate UI
    UI -> Ctrl : POST /TugasLapangan/{id}/temuan -> catat_temuan()
    activate Ctrl
    alt bukan tugasnya / status tidak aktif / tanpa foto, kategori, titik
        Ctrl --> UI : pesan peringatan (mis. "Foto temuan wajib diunggah"), tidak ada yang disimpan
    else valid
        Ctrl -> Lap : KontrolPelaporan.kirim_laporan(sumber="Temuan Penilik", id_warga=None, id_penilik_pencatat)
        note right of Lap
          alur laporan warga yang sama:
          BR-1 foto + AI, BR-2 Risk Score,
          BR-3 deduplikasi (exposure tidak naik
          untuk temuan; tanpa notifikasi warga)
        end note
        Lap -> AS : catat_riwayat(tiket asal, "Penilik mencatat temuan baru <tiket> / <laporan>") sebelum commit
        Ctrl --> UI : "Temuan dicatat sebagai tiket baru ..." / "Temuan digabungkan dengan tiket aktif ..."
    end
    deactivate Ctrl
    UI --> PJ : tampilkan hasil
    deactivate UI
end

opt Rekomendasi tutup tertunda
    Adm -> WOUI : buka Work Order (SPK tidak tampil, POST SPK ditolak)
    activate WOUI
    alt Konfirmasi Tutup Tiket
        WOUI -> Pen : konfirmasi_tutup()
        activate Pen
        Pen -> AS : tutup_tiket(alasan rekomendasi)
        AS -> WO : "Ditutup" + riwayat "Ditutup: <alasan>"
        AS -> Notif : notifikasi berisi alasan
        deactivate Pen
    else Tolak Rekomendasi
        WOUI -> Pen : tolak_rekomendasi()
        activate Pen
        Pen -> AS : catat_riwayat("Rekomendasi tutup ditolak Admin") (status tetap Terinspeksi)
        deactivate Pen
        WOUI --> Adm : form SPK tersedia
    end
    deactivate WOUI
end
@enduml
