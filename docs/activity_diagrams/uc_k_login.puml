@startuml
title Activity Diagram - UC-K: Melakukan Login

|User|
start
:Membuka halaman Login;
:Memasukkan email/nomor HP dan password;
:Menekan tombol "Sign In / Masuk";

|Sistem|
if (Akun terdaftar?) then (Tidak)
  :Menampilkan pesan "Akun tidak ditemukan";
  stop
else (Ya)
  if (Akun aktif?) then (Tidak)
    :Menampilkan pesan "Akun Anda tidak aktif, silakan hubungi administrator";
    stop
  else (Ya)
    if (Password sesuai?) then (Tidak)
      :Menampilkan pesan "Email/nomor HP atau password salah";
      stop
    else (Ya)
      if (Peran pengguna?) then (User / Warga)
        :Mengarahkan User ke halaman Home (Citizen);
      else (Petugas Dinas)
        :Mengarahkan Petugas Dinas ke Dashboard sesuai peran;
      endif
      stop
    endif
  endif
endif
@enduml