DATABASE_URL=postgresql+psycopg2://postgres:password_anda@localhost:5432/scms_pupr_db

# Kunci penanda tangan cookie sesi login. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SCMS_SECRET_KEY=ganti_dengan_string_acak_panjang
# Isi 1 jika aplikasi dilayani lewat HTTPS
SCMS_HTTPS_ONLY=0

# Backend AI (bawaan = simulasi, tanpa model). Lihat README bagian "Mode AI".
SCMS_CV_BACKEND=simulasi
# SCMS_YOLO_WEIGHTS=models/road_damage_yolov8.pt
SCMS_NLP_BACKEND=leksikal
# SCMS_ST_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Izinkan seeder menghapus database selain SQLite (biasanya ditolak)
# SCMS_ALLOW_DB_RESET=1
